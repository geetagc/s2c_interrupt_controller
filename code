module top;
  reg clk,rst;
  environment e;
  intf pif(clk,rst);
  
  s2c_interrupt_controller dut(.enable(pif.enable),
                               .clock(pif.clk),
                               .reset(pif.rst),
                               .power_in(pif.power_in),
                               .edge_detection_mode(pif.edge_detection_mode),
                               .external_wakeup_interrupt(pif.external_wakeup_interrupt),
                               .overflow_int(pif.overflow_int),
                               .match_int(pif.match_int),
                               .wakeup_interrupt(pif.wakeup_interrupt),
                               .clock_req(pif.clock_req),
                               .power_req(pif.power_req));
  
  initial begin
    clk=1'b0;
    forever #4 clk=~clk;
  end
  
  initial begin
    rst=1;
    reset_signals();
    repeat(2)@(posedge clk);
    rst=0;
    e = new();
    e.run();
  end
  
  task reset_signals();
    pif.enable = 0;
    pif.power_in =0 ;
    pif.edge_detection_mode=0;
    pif.external_wakeup_interrupt= 0;
    pif.overflow_int =0;
    pif.match_int=0;
  endtask
  
  initial begin
    #400;
    $finish;
  end
 
  initial begin
    $dumpfile("dump.vcd");
    $dumpvars();
  end
                               
endmodule
  
